[
  { "id": "echinodorus-grisebachii-bleherae", "commonName": "Amazon sword", "scientificName": "Echinodorus grisebachii 'Bleherae'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#4d8a2c", "color2": "#86b84c", "maxHeightCm": 50, "spreadCm": 40, "growthCmPerWeek": 2, "light": "medium", "leafLength": 30, "leafWidth": 5, "leafShape": "lanceolate", "palatable": true, "description": "The classic centrepiece of South American tanks: a broad rosette of bright green, lance-shaped leaves on long petioles. A heavy root feeder that loves root tabs." },
  { "id": "echinodorus-ozelot", "commonName": "Ozelot sword", "scientificName": "Echinodorus 'Ozelot'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#5c8a30", "color2": "#7a3b22", "maxHeightCm": 40, "spreadCm": 35, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 22, "leafWidth": 5.5, "leafShape": "lanceolate", "palatable": true, "description": "A hardy hybrid sword whose green leaves are dappled with reddish-brown leopard spots, strongest on new growth under good light." },
  { "id": "echinodorus-rubin", "commonName": "Red Rubin sword", "scientificName": "Echinodorus 'Rubin'", "water": "freshwater", "form": "rosette", "placement": "background", "color": "#7a2e24", "color2": "#a5482e", "maxHeightCm": 50, "spreadCm": 35, "growthCmPerWeek": 1.8, "light": "medium", "leafLength": 32, "leafWidth": 5, "leafShape": "lanceolate", "palatable": true, "description": "A tall hybrid sword with deep wine-red leaves that slowly turn olive-brown as they age — a striking contrast against green stems." },
  { "id": "echinodorus-cordifolius", "commonName": "Radican sword", "scientificName": "Echinodorus cordifolius", "water": "freshwater", "form": "rosette", "placement": "background", "color": "#4f8b30", "color2": "#79ad4e", "maxHeightCm": 45, "spreadCm": 45, "growthCmPerWeek": 2.5, "light": "medium", "leafLength": 26, "leafWidth": 12, "leafShape": "heart", "palatable": true, "description": "Large, round-to-heart-shaped leaves with prominent veins on long stalks. Given the chance it sends leaves out of the water, so it is often trimmed back." },
  { "id": "helanthium-tenellum", "commonName": "Pygmy chain sword", "scientificName": "Helanthium tenellum", "water": "freshwater", "form": "grass", "placement": "foreground", "color": "#5f9f36", "color2": "#8fc05a", "maxHeightCm": 8, "spreadCm": 10, "growthCmPerWeek": 1, "light": "medium", "leafLength": 7, "leafWidth": 0.25, "leafShape": "lanceolate", "palatable": true, "description": "A tiny sword plant with grass-like leaves that spreads by runners into a soft, bright green lawn in the foreground." },
  { "id": "cryptocoryne-wendtii-green", "commonName": "Crypt wendtii 'Green'", "scientificName": "Cryptocoryne wendtii", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#5a7a32", "color2": "#6b4a2b", "maxHeightCm": 15, "spreadCm": 15, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 10, "leafWidth": 2.2, "leafShape": "lanceolate", "palatable": false, "description": "A Sri Lankan crypt with wavy-edged, olive-green leaves. Undemanding and slow, it may 'melt' after moving but regrows from the rhizome." },
  { "id": "cryptocoryne-wendtii-brown", "commonName": "Crypt wendtii 'Brown'", "scientificName": "Cryptocoryne wendtii 'Brown'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#6e5434", "color2": "#4c3524", "maxHeightCm": 15, "spreadCm": 15, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 10, "leafWidth": 2.2, "leafShape": "lanceolate", "palatable": false, "description": "The bronze-brown form of wendtii with hammered, wavy leaves that glow coppery under the light. Thrives in the shade of larger plants." },
  { "id": "cryptocoryne-beckettii", "commonName": "Crypt beckettii", "scientificName": "Cryptocoryne × willisii 'Petchii'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#5d5a30", "color2": "#7a4430", "maxHeightCm": 12, "spreadCm": 12, "growthCmPerWeek": 0.4, "light": "low", "leafLength": 8, "leafWidth": 1.6, "leafShape": "lanceolate", "palatable": false, "description": "Olive-brown, gently wavy leaves with pinkish undersides on a compact rosette. One of the hardiest crypts in the hobby." },
  { "id": "cryptocoryne-parva", "commonName": "Crypt parva", "scientificName": "Cryptocoryne parva", "water": "freshwater", "form": "rosette", "placement": "foreground", "color": "#4f8a2e", "color2": "#6ca244", "maxHeightCm": 5, "spreadCm": 6, "growthCmPerWeek": 0.15, "light": "medium", "leafLength": 4, "leafWidth": 0.35, "leafShape": "lanceolate", "palatable": false, "description": "The smallest cryptocoryne: dense tufts of narrow, bright green leaves that slowly form a carpet in the foreground." },
  { "id": "cryptocoryne-lutea", "commonName": "Crypt lutea", "scientificName": "Cryptocoryne walkeri 'Lutea'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#5d8d34", "color2": "#8aa846", "maxHeightCm": 15, "spreadCm": 15, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 10, "leafWidth": 1.8, "leafShape": "lanceolate", "palatable": false, "description": "A light green crypt with smooth, lance-shaped leaves that spreads by runners into neat clumps." },
  { "id": "lagenandra-meeboldii-red", "commonName": "Lagenandra 'Red'", "scientificName": "Lagenandra meeboldii 'Red'", "water": "freshwater", "form": "rosette", "placement": "midground", "color": "#8a3f45", "color2": "#c46a6e", "maxHeightCm": 25, "spreadCm": 20, "growthCmPerWeek": 0.4, "light": "medium", "leafLength": 14, "leafWidth": 4, "leafShape": "ovate", "palatable": false, "description": "An Indian aroid with pink-to-burgundy, broadly oval leaves. Slow and tough, it adds a soft red focal point in the midground." },
  { "id": "pogostemon-helferi", "commonName": "Downoi", "scientificName": "Pogostemon helferi", "water": "freshwater", "form": "rosette", "placement": "foreground", "color": "#5ea13a", "color2": "#8cc25a", "maxHeightCm": 8, "spreadCm": 8, "growthCmPerWeek": 0.7, "light": "medium", "leafLength": 3.5, "leafWidth": 0.7, "leafShape": "lanceolate", "palatable": true, "description": "A Thai foreground plant whose crinkled, star-shaped rosettes look like little green starfish. Can also be tied to stone." },
  { "id": "ceratopteris-thalictroides", "commonName": "Water sprite", "scientificName": "Ceratopteris thalictroides", "water": "freshwater", "form": "rosette", "placement": "background", "color": "#78b24a", "color2": "#a2cc6c", "maxHeightCm": 40, "spreadCm": 25, "growthCmPerWeek": 4, "light": "medium", "leafLength": 22, "leafWidth": 7, "leafShape": "lobed", "palatable": true, "description": "A fast, soft aquatic fern with finely divided, lacy fronds. Baby plantlets sprout from old leaves; it also floats happily." },
  { "id": "vallisneria-spiralis", "commonName": "Vallisneria", "scientificName": "Vallisneria spiralis", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#5f9a3a", "color2": "#8cbf5a", "maxHeightCm": 60, "spreadCm": 12, "growthCmPerWeek": 4, "light": "low", "leafLength": 60, "leafWidth": 0.8, "leafShape": "strap", "palatable": false, "description": "Long ribbon leaves that sway in the current and trail along the surface. Spreads by runners into a waving curtain at the back." },
  { "id": "vallisneria-americana-gigantea", "commonName": "Jungle val", "scientificName": "Vallisneria americana var. gigantea", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#4e8a32", "color2": "#7ab04e", "maxHeightCm": 150, "spreadCm": 20, "growthCmPerWeek": 7, "light": "low", "leafLength": 120, "leafWidth": 2.4, "leafShape": "strap", "palatable": false, "description": "A giant vallisneria with broad, tough leaves up to two metres long that blanket the surface of large tanks." },
  { "id": "vallisneria-spiralis-tiger", "commonName": "Tiger vallisneria", "scientificName": "Vallisneria spiralis 'Tiger'", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#6b8f3c", "color2": "#6d4d2c", "maxHeightCm": 70, "spreadCm": 12, "growthCmPerWeek": 4, "light": "low", "leafLength": 65, "leafWidth": 0.9, "leafShape": "strap", "palatable": false, "description": "A vallisneria whose green ribbons carry fine, reddish-brown cross bands like a tiger’s stripes." },
  { "id": "vallisneria-nana", "commonName": "Dwarf vallisneria", "scientificName": "Vallisneria nana", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#5a9638", "color2": "#87bb58", "maxHeightCm": 45, "spreadCm": 8, "growthCmPerWeek": 3, "light": "low", "leafLength": 45, "leafWidth": 0.3, "leafShape": "strap", "palatable": false, "description": "An Australian val with very fine, grass-like ribbons — elegant in smaller tanks where giant vals would swamp the surface." },
  { "id": "sagittaria-subulata", "commonName": "Dwarf sagittaria", "scientificName": "Sagittaria subulata", "water": "freshwater", "form": "ribbon", "placement": "foreground", "color": "#5ea03a", "color2": "#8cc45c", "maxHeightCm": 15, "spreadCm": 10, "growthCmPerWeek": 1.5, "light": "low", "leafLength": 12, "leafWidth": 0.4, "leafShape": "strap", "palatable": true, "description": "Short, grassy strap leaves that run across the substrate on stolons — an easy alternative to hairgrass for low-tech tanks." },
  { "id": "cryptocoryne-balansae", "commonName": "Crypt balansae", "scientificName": "Cryptocoryne crispatula var. balansae", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#4d7d2e", "color2": "#6a5a34", "maxHeightCm": 50, "spreadCm": 15, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 45, "leafWidth": 1.4, "leafShape": "strap", "palatable": false, "description": "Long, narrow, intensely hammered and crinkled leaves rising from a crypt rosette — a textured background for hard water." },
  { "id": "crinum-calamistratum", "commonName": "African onion plant", "scientificName": "Crinum calamistratum", "water": "freshwater", "form": "ribbon", "placement": "background", "color": "#3f7a2e", "color2": "#5d9442", "maxHeightCm": 100, "spreadCm": 20, "growthCmPerWeek": 2, "light": "medium", "leafLength": 90, "leafWidth": 0.5, "leafShape": "strap", "palatable": false, "description": "A Cameroonian bulb plant with very long, tightly crinkled ribbon leaves that tolerate hard water and herbivorous cichlids." },
  { "id": "aponogeton-ulvaceus", "commonName": "Aponogeton ulvaceus", "scientificName": "Aponogeton ulvaceus", "water": "freshwater", "form": "bulb", "placement": "background", "color": "#7bb04a", "color2": "#a6cc6e", "maxHeightCm": 50, "spreadCm": 40, "growthCmPerWeek": 3, "light": "medium", "leafLength": 35, "leafWidth": 5, "leafShape": "strap", "palatable": true, "description": "From Madagascar: a bulb that unfurls translucent, light green leaves with beautifully wavy, ruffled edges that ripple in the current." },
  { "id": "aponogeton-crispus", "commonName": "Ruffled sword", "scientificName": "Aponogeton crispus", "water": "freshwater", "form": "bulb", "placement": "background", "color": "#5e8a36", "color2": "#8a5c38", "maxHeightCm": 40, "spreadCm": 30, "growthCmPerWeek": 2.5, "light": "medium", "leafLength": 30, "leafWidth": 3, "leafShape": "strap", "palatable": true, "description": "A Sri Lankan bulb plant with long, crinkle-edged leaves in green to reddish-brown. Often sold as dry 'wonder bulbs'." },
  { "id": "aponogeton-madagascariensis", "commonName": "Madagascar lace plant", "scientificName": "Aponogeton madagascariensis", "water": "freshwater", "form": "bulb", "placement": "midground", "color": "#5e7f34", "color2": "#8a7a3e", "maxHeightCm": 40, "spreadCm": 40, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 25, "leafWidth": 6, "leafShape": "lobed", "palatable": true, "description": "A legendary plant whose leaves are a living lattice — only the veins remain, forming an open window-like net. Needs cool, soft water." },
  { "id": "aponogeton-boivinianus", "commonName": "Aponogeton boivinianus", "scientificName": "Aponogeton boivinianus", "water": "freshwater", "form": "bulb", "placement": "background", "color": "#355f26", "color2": "#4f7a34", "maxHeightCm": 60, "spreadCm": 40, "growthCmPerWeek": 2, "light": "medium", "leafLength": 45, "leafWidth": 4, "leafShape": "strap", "palatable": true, "description": "Dark green, deeply hammered leaves like crumpled foil arching from a large bulb — a dramatic solitary plant." },
  { "id": "barclaya-longifolia", "commonName": "Orchid lily", "scientificName": "Barclaya longifolia", "water": "freshwater", "form": "bulb", "placement": "midground", "color": "#7a4a32", "color2": "#a03a3a", "maxHeightCm": 45, "spreadCm": 35, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 30, "leafWidth": 3, "leafShape": "strap", "palatable": true, "description": "A Southeast Asian waterlily relative with long, wavy, olive-bronze leaves and wine-red undersides." },
  { "id": "nymphaea-zenkeri", "commonName": "Red tiger lotus", "scientificName": "Nymphaea zenkeri", "water": "freshwater", "form": "lily", "placement": "midground", "color": "#7a2a2c", "color2": "#3a1418", "maxHeightCm": 50, "spreadCm": 40, "growthCmPerWeek": 3, "light": "medium", "leafLength": 12, "leafWidth": 10, "leafShape": "heart", "palatable": true, "description": "A West African waterlily with arrow-shaped, burgundy leaves splashed with darker spots. Trim surface pads to keep the leaves underwater." },
  { "id": "nymphaea-lotus-green", "commonName": "Green tiger lotus", "scientificName": "Nymphaea lotus", "water": "freshwater", "form": "lily", "placement": "midground", "color": "#5a8a36", "color2": "#6e3a26", "maxHeightCm": 50, "spreadCm": 40, "growthCmPerWeek": 3, "light": "medium", "leafLength": 12, "leafWidth": 10, "leafShape": "heart", "palatable": true, "description": "The green form of the tiger lotus, its leaves mottled with reddish-brown blotches. Sends pads up to the surface on long stalks." },
  { "id": "nymphoides-aquatica", "commonName": "Banana plant", "scientificName": "Nymphoides aquatica", "water": "freshwater", "form": "lily", "placement": "foreground", "color": "#4f8d33", "color2": "#7a4a30", "maxHeightCm": 30, "spreadCm": 15, "growthCmPerWeek": 2, "light": "medium", "leafLength": 7, "leafWidth": 6, "leafShape": "heart", "palatable": true, "description": "A Florida native named for its cluster of plump, banana-like storage roots; round leaves rise on thin stalks toward the surface." },
  { "id": "rotala-rotundifolia", "commonName": "Rotala rotundifolia", "scientificName": "Rotala rotundifolia", "water": "freshwater", "form": "stem", "placement": "background", "color": "#78a048", "color2": "#d06c5c", "maxHeightCm": 40, "spreadCm": 10, "growthCmPerWeek": 6, "light": "medium", "leafLength": 1.2, "leafWidth": 0.4, "leafShape": "lanceolate", "palatable": true, "description": "The most popular stem plant: fine, bushy stems that turn pink to red at the tips under stronger light. Trim and replant the tops." },
  { "id": "rotala-macrandra", "commonName": "Giant red rotala", "scientificName": "Rotala macrandra", "water": "freshwater", "form": "stem", "placement": "background", "color": "#a8424a", "color2": "#d8606a", "maxHeightCm": 40, "spreadCm": 12, "growthCmPerWeek": 4, "light": "high", "leafLength": 2.2, "leafWidth": 1.1, "leafShape": "ovate", "palatable": true, "description": "One of the reddest aquarium plants: soft, rounded wine-red leaves with wavy edges. Demands strong light, CO2 and iron." },
  { "id": "rotala-hra", "commonName": "Rotala 'H'ra'", "scientificName": "Rotala sp. 'H'ra'", "water": "freshwater", "form": "stem", "placement": "background", "color": "#8a9a4a", "color2": "#d86a40", "maxHeightCm": 40, "spreadCm": 10, "growthCmPerWeek": 5, "light": "high", "leafLength": 1.5, "leafWidth": 0.35, "leafShape": "lanceolate", "palatable": true, "description": "A fine-leaved rotala that glows orange-red at the crown in high light — prized in Dutch-style 'streets'." },
  { "id": "rotala-wallichii", "commonName": "Rotala wallichii", "scientificName": "Rotala wallichii", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#9a5a48", "color2": "#e07a68", "maxHeightCm": 40, "spreadCm": 8, "growthCmPerWeek": 5, "light": "high", "leafLength": 1.6, "leafWidth": 0.08, "leafShape": "needle", "palatable": true, "description": "Whorls of needle-thin leaves that blush pink to red at the tips, like delicate bottlebrushes. Needs soft water and strong light." },
  { "id": "ludwigia-repens", "commonName": "Ludwigia repens", "scientificName": "Ludwigia repens", "water": "freshwater", "form": "stem", "placement": "background", "color": "#6b7a3a", "color2": "#a64a38", "maxHeightCm": 50, "spreadCm": 12, "growthCmPerWeek": 4, "light": "medium", "leafLength": 2.5, "leafWidth": 1.4, "leafShape": "ovate", "palatable": true, "description": "Robust stems with glossy, oval leaves — olive-green above and red beneath — turning coppery at the top in good light." },
  { "id": "ludwigia-palustris-super-red", "commonName": "Ludwigia 'Super Red'", "scientificName": "Ludwigia palustris 'Super Red'", "water": "freshwater", "form": "stem", "placement": "background", "color": "#8a2f2a", "color2": "#bc463a", "maxHeightCm": 40, "spreadCm": 12, "growthCmPerWeek": 4, "light": "medium", "leafLength": 2.2, "leafWidth": 1.2, "leafShape": "ovate", "palatable": true, "description": "A selected form that stays a deep red even under moderate light — one of the easiest true reds." },
  { "id": "ludwigia-arcuata", "commonName": "Needle-leaf ludwigia", "scientificName": "Ludwigia arcuata", "water": "freshwater", "form": "stem", "placement": "background", "color": "#a4553a", "color2": "#d2704a", "maxHeightCm": 40, "spreadCm": 10, "growthCmPerWeek": 4, "light": "high", "leafLength": 2.2, "leafWidth": 0.25, "leafShape": "lanceolate", "palatable": true, "description": "Slender stems with narrow, needle-like leaves that turn coppery orange to red. Beautiful in groups against green plants." },
  { "id": "ammannia-gracilis", "commonName": "Ammannia gracilis", "scientificName": "Ammannia gracilis", "water": "freshwater", "form": "stem", "placement": "background", "color": "#9a5a3c", "color2": "#c86c4a", "maxHeightCm": 50, "spreadCm": 15, "growthCmPerWeek": 4, "light": "high", "leafLength": 6, "leafWidth": 0.8, "leafShape": "lanceolate", "palatable": true, "description": "An African stem with long, narrow, orange-to-salmon leaves in opposite pairs. Tall and architectural in the back corner." },
  { "id": "bacopa-caroliniana", "commonName": "Lemon bacopa", "scientificName": "Bacopa caroliniana", "water": "freshwater", "form": "stem", "placement": "background", "color": "#78a04a", "color2": "#b0864c", "maxHeightCm": 40, "spreadCm": 10, "growthCmPerWeek": 2, "light": "medium", "leafLength": 2, "leafWidth": 1.2, "leafShape": "ovate", "palatable": true, "description": "Thick, upright stems with fleshy oval leaves that smell of lemon when crushed; the crown turns bronze under strong light." },
  { "id": "bacopa-monnieri", "commonName": "Moneywort", "scientificName": "Bacopa monnieri", "water": "freshwater", "form": "stem", "placement": "midground", "color": "#6f9a40", "color2": "#90b858", "maxHeightCm": 30, "spreadCm": 10, "growthCmPerWeek": 2, "light": "low", "leafLength": 1.5, "leafWidth": 0.7, "leafShape": "ovate", "palatable": true, "description": "A hardy, slow stem with small, succulent, spoon-shaped leaves — tolerant of almost any conditions." },
  { "id": "hygrophila-polysperma", "commonName": "Dwarf hygrophila", "scientificName": "Hygrophila polysperma", "water": "freshwater", "form": "stem", "placement": "background", "color": "#78a64a", "color2": "#a4b85a", "maxHeightCm": 40, "spreadCm": 12, "growthCmPerWeek": 8, "light": "low", "leafLength": 3, "leafWidth": 0.9, "leafShape": "lanceolate", "palatable": true, "description": "A fast, forgiving stem with light green, lance-shaped leaves that soaks up nitrate and helps keep algae in check." },
  { "id": "hygrophila-corymbosa", "commonName": "Giant hygrophila", "scientificName": "Hygrophila corymbosa", "water": "freshwater", "form": "stem", "placement": "background", "color": "#58892f", "color2": "#7aa44a", "maxHeightCm": 60, "spreadCm": 20, "growthCmPerWeek": 6, "light": "medium", "leafLength": 10, "leafWidth": 3, "leafShape": "lanceolate", "palatable": true, "description": "A big, bold stem with large, glossy leaves — a quick way to fill the background of a new tank." },
  { "id": "hygrophila-difformis", "commonName": "Water wisteria", "scientificName": "Hygrophila difformis", "water": "freshwater", "form": "stem", "placement": "background", "color": "#6ea442", "color2": "#94c062", "maxHeightCm": 50, "spreadCm": 20, "growthCmPerWeek": 7, "light": "low", "leafLength": 7, "leafWidth": 4, "leafShape": "lobed", "palatable": true, "description": "Soft, deeply lobed, almost lacy leaves on fast stems. Leaf shape changes with light — more finely divided under strong light." },
  { "id": "hygrophila-pinnatifida", "commonName": "Hygrophila pinnatifida", "scientificName": "Hygrophila pinnatifida", "water": "freshwater", "form": "stem", "placement": "midground", "color": "#6a6a34", "color2": "#8a3a34", "maxHeightCm": 30, "spreadCm": 15, "growthCmPerWeek": 2, "light": "medium", "leafLength": 7, "leafWidth": 2.5, "leafShape": "lobed", "palatable": true, "description": "An Indian hygro with pinnately cut, olive-brown leaves with red undersides. It creeps along wood and stone like an epiphyte." },
  { "id": "alternanthera-reineckii-mini", "commonName": "Alternanthera 'Mini'", "scientificName": "Alternanthera reineckii 'Mini'", "water": "freshwater", "form": "stem", "placement": "midground", "color": "#8a2c3a", "color2": "#b23c4c", "maxHeightCm": 15, "spreadCm": 10, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 2, "leafWidth": 0.6, "leafShape": "lanceolate", "palatable": true, "description": "A compact, bushy red stem plant that stays low — ideal for a splash of purple-red in the midground." },
  { "id": "alternanthera-reineckii-rosaefolia", "commonName": "Alternanthera rosaefolia", "scientificName": "Alternanthera reineckii 'Rosaefolia'", "water": "freshwater", "form": "stem", "placement": "background", "color": "#7a3038", "color2": "#a8445a", "maxHeightCm": 40, "spreadCm": 12, "growthCmPerWeek": 2, "light": "medium", "leafLength": 4, "leafWidth": 1.2, "leafShape": "lanceolate", "palatable": true, "description": "Lance-shaped leaves in olive-red above and vivid magenta beneath on sturdy stems." },
  { "id": "limnophila-sessiliflora", "commonName": "Asian ambulia", "scientificName": "Limnophila sessiliflora", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#78ae40", "color2": "#a2cc5e", "maxHeightCm": 50, "spreadCm": 10, "growthCmPerWeek": 9, "light": "low", "leafLength": 3, "leafWidth": 0.1, "leafShape": "feathery", "palatable": true, "description": "Soft whorls of finely divided, bright green leaves on fast stems — a hardy, feathery background plant." },
  { "id": "limnophila-aromatica", "commonName": "Rice paddy herb", "scientificName": "Limnophila aromatica", "water": "freshwater", "form": "stem", "placement": "background", "color": "#7c8a48", "color2": "#9c4c7c", "maxHeightCm": 40, "spreadCm": 12, "growthCmPerWeek": 4, "light": "medium", "leafLength": 3.5, "leafWidth": 0.8, "leafShape": "lanceolate", "palatable": true, "description": "A culinary herb in Vietnam; underwater its lance-shaped leaves turn bronze-green above and purple-pink beneath." },
  { "id": "cabomba-caroliniana", "commonName": "Green cabomba", "scientificName": "Cabomba caroliniana", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#78a83a", "color2": "#9cc458", "maxHeightCm": 50, "spreadCm": 10, "growthCmPerWeek": 7, "light": "medium", "leafLength": 4, "leafWidth": 4, "leafShape": "feathery", "palatable": true, "description": "Elegant stems lined with bright green, fan-shaped, finely forked leaves — like miniature parasols stacked up toward the light." },
  { "id": "cabomba-furcata", "commonName": "Red cabomba", "scientificName": "Cabomba furcata", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#b2463c", "color2": "#d6644c", "maxHeightCm": 50, "spreadCm": 10, "growthCmPerWeek": 4, "light": "high", "leafLength": 3, "leafWidth": 3, "leafShape": "feathery", "palatable": true, "description": "A spectacular red-violet cabomba with whorls of finely divided leaves. Needs strong light and CO2 to keep its colour." },
  { "id": "ceratophyllum-demersum", "commonName": "Hornwort", "scientificName": "Ceratophyllum demersum", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#4a7a2c", "color2": "#6a9a3a", "maxHeightCm": 60, "spreadCm": 10, "growthCmPerWeek": 12, "light": "low", "leafLength": 2.5, "leafWidth": 0.08, "leafShape": "needle", "palatable": true, "description": "A rootless, extremely fast-growing plant with whorls of stiff, forked needles crowded into a 'fox tail' at the tip. A superb nutrient sponge." },
  { "id": "egeria-densa", "commonName": "Brazilian waterweed", "scientificName": "Egeria densa", "water": "freshwater", "form": "stem", "placement": "background", "color": "#68a23a", "color2": "#8cc456", "maxHeightCm": 60, "spreadCm": 10, "growthCmPerWeek": 9, "light": "low", "leafLength": 2.5, "leafWidth": 0.35, "leafShape": "strap", "palatable": true, "description": "The classic 'anacharis': dense whorls of small strap leaves on fast stems. Goldfish love to graze it." },
  { "id": "myriophyllum-mattogrossense", "commonName": "Green milfoil", "scientificName": "Myriophyllum mattogrossense", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#86b048", "color2": "#b07e4a", "maxHeightCm": 40, "spreadCm": 8, "growthCmPerWeek": 5, "light": "medium", "leafLength": 2, "leafWidth": 0.1, "leafShape": "feathery", "palatable": true, "description": "Feathery whorls of pinnate leaves in light green, tipped bronze under strong light. Soft and graceful in the current." },
  { "id": "pogostemon-erectus", "commonName": "Pogostemon erectus", "scientificName": "Pogostemon erectus", "water": "freshwater", "form": "fine-stem", "placement": "background", "color": "#7cb648", "color2": "#a0ce64", "maxHeightCm": 30, "spreadCm": 6, "growthCmPerWeek": 3, "light": "high", "leafLength": 1.5, "leafWidth": 0.1, "leafShape": "needle", "palatable": true, "description": "Upright stems densely clothed in whorls of fine needle leaves — like miniature pine trees in a neat row." },
  { "id": "staurogyne-repens", "commonName": "Staurogyne repens", "scientificName": "Staurogyne repens", "water": "freshwater", "form": "stem", "placement": "foreground", "color": "#5f9a36", "color2": "#82b452", "maxHeightCm": 10, "spreadCm": 10, "growthCmPerWeek": 1, "light": "medium", "leafLength": 2, "leafWidth": 0.8, "leafShape": "lanceolate", "palatable": true, "description": "A compact Amazonian stem plant that creeps sideways, forming low, bushy cushions of rich green leaves in the foreground." },
  { "id": "hemianthus-micranthemoides", "commonName": "Pearlweed", "scientificName": "Micranthemum glomeratum", "water": "freshwater", "form": "stem", "placement": "midground", "color": "#76b244", "color2": "#9cca60", "maxHeightCm": 20, "spreadCm": 10, "growthCmPerWeek": 4, "light": "medium", "leafLength": 0.7, "leafWidth": 0.3, "leafShape": "ovate", "palatable": true, "description": "Tiny bright leaves on fine, branching stems that can be clipped into soft bushes. Named for the oxygen pearls that collect on it." },
  { "id": "hydrocotyle-leucocephala", "commonName": "Brazilian pennywort", "scientificName": "Hydrocotyle leucocephala", "water": "freshwater", "form": "stem", "placement": "background", "color": "#78b04a", "color2": "#9ccc66", "maxHeightCm": 50, "spreadCm": 15, "growthCmPerWeek": 6, "light": "low", "leafLength": 3, "leafWidth": 3, "leafShape": "round", "palatable": true, "description": "Round, scalloped, bright green leaves on long trailing stems that wander toward the surface and float." },
  { "id": "hydrocotyle-tripartita", "commonName": "Hydrocotyle 'Japan'", "scientificName": "Hydrocotyle tripartita", "water": "freshwater", "form": "carpet", "placement": "foreground", "color": "#6ab03e", "color2": "#90c85c", "maxHeightCm": 5, "spreadCm": 20, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 0.8, "leafWidth": 0.9, "leafShape": "lobed", "palatable": true, "description": "Tiny, three-lobed clover-like leaves on creeping stems that weave into a fluffy, bright green carpet." },
  { "id": "microsorum-pteropus", "commonName": "Java fern", "scientificName": "Microsorum pteropus", "water": "freshwater", "form": "epiphyte-fern", "placement": "epiphyte", "color": "#3f6a2a", "color2": "#24361a", "maxHeightCm": 30, "spreadCm": 25, "growthCmPerWeek": 0.4, "light": "low", "leafLength": 20, "leafWidth": 4, "leafShape": "lanceolate", "palatable": false, "description": "A tough, slow fern grown on wood or rock, never in the substrate. Its leathery leaves are ignored by herbivores and produce plantlets at the tips." },
  { "id": "microsorum-pteropus-windelov", "commonName": "Java fern 'Windelov'", "scientificName": "Microsorum pteropus 'Windelov'", "water": "freshwater", "form": "epiphyte-fern", "placement": "epiphyte", "color": "#456e2c", "color2": "#2a3c1c", "maxHeightCm": 20, "spreadCm": 20, "growthCmPerWeek": 0.3, "light": "low", "leafLength": 15, "leafWidth": 1.6, "leafShape": "lobed", "palatable": false, "description": "A lace java fern whose leaf tips fork again and again into frilly, antler-like ends. Grows on driftwood and stone." },
  { "id": "microsorum-pteropus-narrow", "commonName": "Narrow-leaf java fern", "scientificName": "Microsorum pteropus 'Narrow'", "water": "freshwater", "form": "epiphyte-fern", "placement": "epiphyte", "color": "#3c682a", "color2": "#26381a", "maxHeightCm": 25, "spreadCm": 20, "growthCmPerWeek": 0.4, "light": "low", "leafLength": 20, "leafWidth": 1.1, "leafShape": "lanceolate", "palatable": false, "description": "Slim, gently arching leaves form graceful, flowing tufts on wood — perfect for softening hardscape edges." },
  { "id": "microsorum-pteropus-trident", "commonName": "Java fern 'Trident'", "scientificName": "Microsorum pteropus 'Trident'", "water": "freshwater", "form": "epiphyte-fern", "placement": "epiphyte", "color": "#3e6c2c", "color2": "#26381a", "maxHeightCm": 20, "spreadCm": 15, "growthCmPerWeek": 0.3, "light": "low", "leafLength": 14, "leafWidth": 1.5, "leafShape": "lobed", "palatable": false, "description": "A compact java fern with narrow leaves split into three to five slender lobes, like a trident." },
  { "id": "bolbitis-heudelotii", "commonName": "African water fern", "scientificName": "Bolbitis heudelotii", "water": "freshwater", "form": "epiphyte-fern", "placement": "epiphyte", "color": "#2f5a26", "color2": "#40702e", "maxHeightCm": 35, "spreadCm": 30, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 22, "leafWidth": 9, "leafShape": "lobed", "palatable": false, "description": "A Congo-basin fern with dark, translucent, deeply divided fronds. Attach to wood in the current and it slowly forms a lush thicket." },
  { "id": "anubias-barteri", "commonName": "Anubias barteri", "scientificName": "Anubias barteri var. barteri", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#33662a", "color2": "#3e7a30", "maxHeightCm": 30, "spreadCm": 30, "growthCmPerWeek": 0.3, "light": "low", "leafLength": 12, "leafWidth": 6, "leafShape": "heart", "palatable": false, "description": "Leathery, dark green, heart-based leaves on a creeping rhizome tied to wood or rock. Practically indestructible and untouched by herbivores." },
  { "id": "anubias-barteri-nana", "commonName": "Anubias nana", "scientificName": "Anubias barteri var. nana", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#35692c", "color2": "#407c32", "maxHeightCm": 10, "spreadCm": 15, "growthCmPerWeek": 0.2, "light": "low", "leafLength": 6, "leafWidth": 3.5, "leafShape": "ovate", "palatable": false, "description": "A compact anubias with thick, glossy, oval leaves — the go-to plant for wood and stone in any tank, even with cichlids." },
  { "id": "anubias-nana-petite", "commonName": "Anubias nana 'Petite'", "scientificName": "Anubias barteri var. nana 'Petite'", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#305e28", "color2": "#428034", "maxHeightCm": 5, "spreadCm": 8, "growthCmPerWeek": 0.1, "light": "low", "leafLength": 2.5, "leafWidth": 1.6, "leafShape": "ovate", "palatable": false, "description": "A miniature anubias with fingernail-sized leaves that tucks neatly into crevices of stone and wood." },
  { "id": "anubias-coffeefolia", "commonName": "Anubias coffeefolia", "scientificName": "Anubias barteri var. coffeefolia", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#2f5a26", "color2": "#6a3a2a", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.2, "light": "low", "leafLength": 8, "leafWidth": 4, "leafShape": "ovate", "palatable": false, "description": "Like a coffee plant: deeply quilted, wavy leaves that emerge a reddish-bronze before turning dark green." },
  { "id": "bucephalandra-brownie", "commonName": "Bucephalandra 'Brownie'", "scientificName": "Bucephalandra sp. 'Brownie'", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#3c4a2c", "color2": "#5c3a48", "maxHeightCm": 8, "spreadCm": 10, "growthCmPerWeek": 0.15, "light": "low", "leafLength": 4, "leafWidth": 1.4, "leafShape": "lanceolate", "palatable": false, "description": "A Bornean rheophyte with small, bronze-green leaves dusted with iridescent blue speckles. Tied to stone in gentle current." },
  { "id": "bucephalandra-wavy-green", "commonName": "Bucephalandra 'Wavy Green'", "scientificName": "Bucephalandra sp. 'Wavy Green'", "water": "freshwater", "form": "epiphyte-broadleaf", "placement": "epiphyte", "color": "#3c5c2c", "color2": "#4c6e34", "maxHeightCm": 10, "spreadCm": 12, "growthCmPerWeek": 0.15, "light": "low", "leafLength": 5, "leafWidth": 1.5, "leafShape": "lanceolate", "palatable": false, "description": "Narrow, deep green leaves with rippled edges on a creeping rhizome — slow, elegant and hardy." },
  { "id": "micranthemum-monte-carlo", "commonName": "Monte Carlo", "scientificName": "Micranthemum tweediei 'Monte Carlo'", "water": "freshwater", "form": "carpet", "placement": "foreground", "color": "#68ac3a", "color2": "#8cc456", "maxHeightCm": 3, "spreadCm": 20, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 0.6, "leafWidth": 0.55, "leafShape": "round", "palatable": true, "description": "An Argentinian carpeting plant with tiny round leaves that knits a dense, bright green lawn — easier than HC." },
  { "id": "hemianthus-callitrichoides-cuba", "commonName": "Dwarf baby tears (HC)", "scientificName": "Hemianthus callitrichoides 'Cuba'", "water": "freshwater", "form": "carpet", "placement": "foreground", "color": "#76b83e", "color2": "#98cc5a", "maxHeightCm": 2, "spreadCm": 15, "growthCmPerWeek": 1, "light": "high", "leafLength": 0.3, "leafWidth": 0.25, "leafShape": "round", "palatable": true, "description": "One of the smallest aquatic plants on earth. With strong light and CO2 it forms a velvety carpet that pearls with oxygen bubbles." },
  { "id": "glossostigma-elatinoides", "commonName": "Glossostigma", "scientificName": "Glossostigma elatinoides", "water": "freshwater", "form": "carpet", "placement": "foreground", "color": "#5aa03a", "color2": "#80bc56", "maxHeightCm": 3, "spreadCm": 20, "growthCmPerWeek": 2.5, "light": "high", "leafLength": 0.8, "leafWidth": 0.35, "leafShape": "ovate", "palatable": true, "description": "Paired spoon-shaped leaves on runners create a fast, fresh green carpet; under weak light it grows upright instead." },
  { "id": "marsilea-hirsuta", "commonName": "Dwarf water clover", "scientificName": "Marsilea hirsuta", "water": "freshwater", "form": "carpet", "placement": "foreground", "color": "#5d9a38", "color2": "#7cb44e", "maxHeightCm": 4, "spreadCm": 20, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 1, "leafWidth": 1, "leafShape": "lobed", "palatable": true, "description": "An aquatic fern with tiny four-leaf-clover fronds that slowly creeps into a low-light carpet." },
  { "id": "lilaeopsis-brasiliensis", "commonName": "Micro sword", "scientificName": "Lilaeopsis brasiliensis", "water": "freshwater", "form": "grass", "placement": "foreground", "color": "#5c9c38", "color2": "#86b854", "maxHeightCm": 6, "spreadCm": 10, "growthCmPerWeek": 0.8, "light": "medium", "leafLength": 5, "leafWidth": 0.25, "leafShape": "strap", "palatable": true, "description": "Short, flat, bright green blades that spread by runners into a lawn-like foreground, sturdier than hairgrass." },
  { "id": "eleocharis-acicularis", "commonName": "Dwarf hairgrass", "scientificName": "Eleocharis acicularis", "water": "freshwater", "form": "grass", "placement": "foreground", "color": "#66a83e", "color2": "#a6c868", "maxHeightCm": 10, "spreadCm": 8, "growthCmPerWeek": 1.2, "light": "medium", "leafLength": 9, "leafWidth": 0.06, "leafShape": "needle", "palatable": true, "description": "Fine, needle-thin blades that spread by runners into a meadow that ripples in the current — the classic Iwagumi carpet." },
  { "id": "eleocharis-parvula", "commonName": "Mini hairgrass", "scientificName": "Eleocharis parvula", "water": "freshwater", "form": "grass", "placement": "foreground", "color": "#6aac40", "color2": "#9cc664", "maxHeightCm": 5, "spreadCm": 8, "growthCmPerWeek": 1, "light": "medium", "leafLength": 4, "leafWidth": 0.06, "leafShape": "needle", "palatable": true, "description": "A shorter, denser hairgrass that forms a fine, low turf without needing much trimming." },
  { "id": "eleocharis-montevidensis", "commonName": "Giant hairgrass", "scientificName": "Eleocharis montevidensis", "water": "freshwater", "form": "grass", "placement": "background", "color": "#5ea43a", "color2": "#8cbe5a", "maxHeightCm": 50, "spreadCm": 10, "growthCmPerWeek": 3, "light": "medium", "leafLength": 45, "leafWidth": 0.12, "leafShape": "needle", "palatable": true, "description": "Tall, rush-like stems that rise in a fine vertical curtain and lean gracefully with the flow." },
  { "id": "taxiphyllum-barbieri", "commonName": "Java moss", "scientificName": "Taxiphyllum barbieri", "water": "freshwater", "form": "moss", "placement": "epiphyte", "color": "#3e6a26", "color2": "#5a8a36", "maxHeightCm": 4, "spreadCm": 15, "growthCmPerWeek": 0.6, "light": "low", "leafLength": 1.5, "leafWidth": 0.1, "leafShape": "feathery", "palatable": false, "description": "Tangled, fine-leaved moss that covers wood and stone in shaggy green. Shrimp graze it endlessly and fry hide in it." },
  { "id": "vesicularia-montagnei", "commonName": "Christmas moss", "scientificName": "Vesicularia montagnei", "water": "freshwater", "form": "moss", "placement": "epiphyte", "color": "#3a6424", "color2": "#56823a", "maxHeightCm": 3, "spreadCm": 15, "growthCmPerWeek": 0.4, "light": "low", "leafLength": 1.5, "leafWidth": 0.1, "leafShape": "feathery", "palatable": false, "description": "Grows in neat, triangular, fir-tree fronds layered like a Christmas tree — tidier and denser than java moss." },
  { "id": "taxiphyllum-flame", "commonName": "Flame moss", "scientificName": "Taxiphyllum sp. 'Flame'", "water": "freshwater", "form": "moss", "placement": "epiphyte", "color": "#365e22", "color2": "#4e7a30", "maxHeightCm": 6, "spreadCm": 10, "growthCmPerWeek": 0.4, "light": "low", "leafLength": 2.5, "leafWidth": 0.1, "leafShape": "feathery", "palatable": false, "description": "Upright, twisting tufts of dark green moss that flicker upward like little flames." },
  { "id": "vesicularia-ferriei", "commonName": "Weeping moss", "scientificName": "Vesicularia ferriei", "water": "freshwater", "form": "moss", "placement": "epiphyte", "color": "#3c6626", "color2": "#58843a", "maxHeightCm": 4, "spreadCm": 15, "growthCmPerWeek": 0.5, "light": "low", "leafLength": 2, "leafWidth": 0.1, "leafShape": "feathery", "palatable": false, "description": "Its branches droop downward like a weeping willow — perfect cascading from the edge of wood or stone." },
  { "id": "fissidens-fontanus", "commonName": "Phoenix moss", "scientificName": "Fissidens fontanus", "water": "freshwater", "form": "moss", "placement": "epiphyte", "color": "#3a6a28", "color2": "#548a38", "maxHeightCm": 2, "spreadCm": 8, "growthCmPerWeek": 0.15, "light": "low", "leafLength": 0.8, "leafWidth": 0.15, "leafShape": "feathery", "palatable": false, "description": "A tiny North American moss whose fronds look like miniature ferns, forming a dense, velvety cushion on stone." },
  { "id": "aegagropila-linnaei", "commonName": "Marimo moss ball", "scientificName": "Aegagropila linnaei", "water": "freshwater", "form": "ball", "placement": "foreground", "color": "#2f5a26", "color2": "#43702f", "maxHeightCm": 6, "spreadCm": 6, "growthCmPerWeek": 0.01, "light": "low", "leafLength": 0.5, "leafWidth": 0.02, "leafShape": "needle", "palatable": false, "description": "Not a moss but a velvety sphere of filamentous green algae, rolled round by lake currents. Grows only about 5 mm a year." },
  { "id": "limnobium-laevigatum", "commonName": "Amazon frogbit", "scientificName": "Limnobium laevigatum", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#5c9a3a", "color2": "#8ab85a", "maxHeightCm": 12, "spreadCm": 25, "growthCmPerWeek": 3, "light": "low", "leafLength": 2.5, "leafWidth": 2.3, "leafShape": "round", "palatable": true, "description": "Floating rosettes of round, spongy leaves trailing long, feathery white roots — soft, dappled shade for surface fish." },
  { "id": "salvinia-minima", "commonName": "Water spangles", "scientificName": "Salvinia minima", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#6aa63e", "color2": "#8a6a3a", "maxHeightCm": 4, "spreadCm": 25, "growthCmPerWeek": 3, "light": "low", "leafLength": 1.2, "leafWidth": 1, "leafShape": "ovate", "palatable": true, "description": "A tiny floating fern with paired, hairy, water-repellent oval leaves and brown, root-like submerged fronds." },
  { "id": "phyllanthus-fluitans", "commonName": "Red root floater", "scientificName": "Phyllanthus fluitans", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#6e8a3a", "color2": "#a83c2c", "maxHeightCm": 5, "spreadCm": 20, "growthCmPerWeek": 2, "light": "medium", "leafLength": 1.2, "leafWidth": 1.2, "leafShape": "round", "palatable": true, "description": "Round, cupped floating leaves that blush red under strong light, with fine red roots dangling below." },
  { "id": "lemna-minor", "commonName": "Duckweed", "scientificName": "Lemna minor", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#78b23e", "color2": "#9ccc58", "maxHeightCm": 2, "spreadCm": 30, "growthCmPerWeek": 5, "light": "low", "leafLength": 0.35, "leafWidth": 0.25, "leafShape": "ovate", "palatable": true, "description": "The world’s smallest flowering plant: tiny oval fronds, each with a single hair-like root, that double in days." },
  { "id": "pistia-stratiotes", "commonName": "Water lettuce", "scientificName": "Pistia stratiotes", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#8ab464", "color2": "#a8c884", "maxHeightCm": 20, "spreadCm": 25, "growthCmPerWeek": 2, "light": "medium", "leafLength": 9, "leafWidth": 5, "leafShape": "ovate", "palatable": true, "description": "Velvety, pale green rosettes of ribbed leaves like floating lettuces, with long, feathery root curtains beneath." },
  { "id": "riccia-fluitans", "commonName": "Crystalwort", "scientificName": "Riccia fluitans", "water": "freshwater", "form": "floating", "placement": "floating", "color": "#7cbc40", "color2": "#a2d062", "maxHeightCm": 3, "spreadCm": 20, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 1, "leafWidth": 0.1, "leafShape": "feathery", "palatable": true, "description": "A floating liverwort of forked, bright green threads that mats at the surface — or, tied to stone, pearls like a jewel." }
]
