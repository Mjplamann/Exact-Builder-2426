[
  { "id": "chaetomorpha-linum", "commonName": "Chaeto", "scientificName": "Chaetomorpha linum", "water": "marine", "form": "macroalgae", "placement": "background", "color": "#6aa62c", "color2": "#8cc040", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 2, "light": "medium", "leafLength": 6, "leafWidth": 0.05, "leafShape": "needle", "palatable": true, "description": "A springy, tangled mass of wiry green filaments like steel wool — the reefkeeper’s favourite nutrient export and pod refuge." },
  { "id": "caulerpa-prolifera", "commonName": "Flat-blade caulerpa", "scientificName": "Caulerpa prolifera", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#3e8a2a", "color2": "#5ca63c", "maxHeightCm": 12, "spreadCm": 25, "growthCmPerWeek": 3, "light": "medium", "leafLength": 8, "leafWidth": 1.2, "leafShape": "strap", "palatable": true, "description": "Smooth, bright green strap-like blades rising from creeping runners. Grows fast — and each frond is part of one giant cell." },
  { "id": "caulerpa-racemosa", "commonName": "Grape caulerpa", "scientificName": "Caulerpa racemosa", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#5aa83a", "color2": "#7cc054", "maxHeightCm": 8, "spreadCm": 25, "growthCmPerWeek": 2.5, "light": "medium", "leafLength": 4, "leafWidth": 0.5, "leafShape": "round", "palatable": true, "description": "Upright stalks studded with glossy green 'grapes' — sea grapes, eaten as umibudo in Okinawa and adored by tangs." },
  { "id": "caulerpa-sertularioides", "commonName": "Feather caulerpa", "scientificName": "Caulerpa sertularioides", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#4e9a32", "color2": "#72b64a", "maxHeightCm": 10, "spreadCm": 25, "growthCmPerWeek": 2.5, "light": "medium", "leafLength": 6, "leafWidth": 1.2, "leafShape": "feathery", "palatable": true, "description": "Delicate, feather-like fronds with paired needle branchlets rising from runners across rock and sand." },
  { "id": "gracilaria-parvispora", "commonName": "Red ogo", "scientificName": "Gracilaria parvispora", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#8e2c2a", "color2": "#b44a3a", "maxHeightCm": 18, "spreadCm": 18, "growthCmPerWeek": 1.5, "light": "medium", "leafLength": 5, "leafWidth": 0.3, "leafShape": "needle", "palatable": true, "description": "Bushy tufts of crisp, cylindrical, branching red thalli — a favourite fresh food for tangs and rabbitfish." },
  { "id": "halymenia-dilatata", "commonName": "Dragon's breath algae", "scientificName": "Halymenia dilatata", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#a32a32", "color2": "#d65a52", "maxHeightCm": 20, "spreadCm": 20, "growthCmPerWeek": 1, "light": "medium", "leafLength": 10, "leafWidth": 6, "leafShape": "lobed", "palatable": true, "description": "Broad, ruffled, translucent blades in glowing crimson that look like flames when backlit." },
  { "id": "ulva-lactuca", "commonName": "Sea lettuce", "scientificName": "Ulva lactuca", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#6abc3a", "color2": "#90d058", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 2, "light": "medium", "leafLength": 10, "leafWidth": 7, "leafShape": "lobed", "palatable": true, "description": "Thin, crumpled sheets of vivid green, only two cells thick and almost see-through." },
  { "id": "halimeda-opuntia", "commonName": "Money plant", "scientificName": "Halimeda opuntia", "water": "marine", "form": "macroalgae", "placement": "midground", "color": "#6a9a3a", "color2": "#c8d0a0", "maxHeightCm": 12, "spreadCm": 15, "growthCmPerWeek": 0.5, "light": "medium", "leafLength": 1.2, "leafWidth": 1.2, "leafShape": "round", "palatable": false, "description": "Chains of small, calcified, coin-shaped segments — much of the white sand on tropical beaches comes from Halimeda." },
  { "id": "thalassia-testudinum", "commonName": "Turtle grass", "scientificName": "Thalassia testudinum", "water": "marine", "form": "seagrass", "placement": "foreground", "color": "#4e7a2a", "color2": "#7a8a3a", "maxHeightCm": 30, "spreadCm": 15, "growthCmPerWeek": 2, "light": "high", "leafLength": 25, "leafWidth": 1, "leafShape": "strap", "palatable": true, "description": "A true flowering plant of Caribbean meadows: flat, ribbon-like blades rising from rhizomes buried in sand." },
  { "id": "syringodium-filiforme", "commonName": "Manatee grass", "scientificName": "Syringodium filiforme", "water": "marine", "form": "seagrass", "placement": "foreground", "color": "#5a8a30", "color2": "#7c9c44", "maxHeightCm": 30, "spreadCm": 12, "growthCmPerWeek": 2, "light": "high", "leafLength": 25, "leafWidth": 0.2, "leafShape": "needle", "palatable": true, "description": "Slender, rounded leaves like green spaghetti that sway in dense meadows grazed by manatees and turtles." },
  { "id": "halodule-wrightii", "commonName": "Shoal grass", "scientificName": "Halodule wrightii", "water": "marine", "form": "seagrass", "placement": "foreground", "color": "#5e8c34", "color2": "#86a44a", "maxHeightCm": 15, "spreadCm": 12, "growthCmPerWeek": 1.5, "light": "high", "leafLength": 12, "leafWidth": 0.25, "leafShape": "strap", "palatable": true, "description": "A small, fine-bladed seagrass of shallow flats, the first to colonise bare sand." },
  { "id": "sarcophyton-toadstool", "commonName": "Toadstool leather", "scientificName": "Sarcophyton sp.", "water": "marine", "form": "soft-coral", "placement": "midground", "color": "#cbb98a", "color2": "#a6cc80", "maxHeightCm": 20, "spreadCm": 25, "growthCmPerWeek": 0.25, "light": "medium", "leafLength": 1.2, "leafWidth": 0.15, "leafShape": "needle", "palatable": false, "description": "A mushroom-shaped soft coral: a smooth stalk crowned by a wavy cap covered in long polyps that sway like grass." },
  { "id": "sinularia-flexibilis", "commonName": "Finger leather", "scientificName": "Sinularia flexibilis", "water": "marine", "form": "soft-coral", "placement": "midground", "color": "#b7aa88", "color2": "#e2dac4", "maxHeightCm": 25, "spreadCm": 25, "growthCmPerWeek": 0.3, "light": "medium", "leafLength": 0.8, "leafWidth": 0.1, "leafShape": "needle", "palatable": false, "description": "A soft coral of long, flexible, finger-like branches that wave gently in the current, its polyps giving a fuzzy look." },
  { "id": "capnella-imbricata", "commonName": "Kenya tree", "scientificName": "Capnella imbricata", "water": "marine", "form": "soft-coral", "placement": "midground", "color": "#9c8a68", "color2": "#c8b896", "maxHeightCm": 20, "spreadCm": 15, "growthCmPerWeek": 0.4, "light": "medium", "leafLength": 0.6, "leafWidth": 0.08, "leafShape": "needle", "palatable": false, "description": "A little branching 'tree' of soft coral with polyp-covered twigs; it drops branchlets that grow into new trees." },
  { "id": "xenia-elongata", "commonName": "Pulsing xenia", "scientificName": "Xenia elongata", "water": "marine", "form": "soft-coral", "placement": "midground", "color": "#e6dccb", "color2": "#b4c6e6", "maxHeightCm": 8, "spreadCm": 12, "growthCmPerWeek": 0.5, "light": "medium", "leafLength": 1.5, "leafWidth": 0.2, "leafShape": "feathery", "palatable": false, "description": "Stalks topped with feathery, eight-armed polyps that open and close in a hypnotic rhythm — nobody is quite sure why." },
  { "id": "briareum-violaceum", "commonName": "Green star polyps", "scientificName": "Briareum violaceum", "water": "marine", "form": "soft-coral", "placement": "epiphyte", "color": "#6a3a7a", "color2": "#6ae04c", "maxHeightCm": 2, "spreadCm": 20, "growthCmPerWeek": 0.6, "light": "medium", "leafLength": 0.8, "leafWidth": 0.12, "leafShape": "needle", "palatable": false, "description": "A purple mat that grows over rock and glass, sprouting a lawn of neon-green star-shaped polyps that sway in the flow." },
  { "id": "clavularia-viridis", "commonName": "Clove polyps", "scientificName": "Clavularia viridis", "water": "marine", "form": "soft-coral", "placement": "epiphyte", "color": "#8a7a5c", "color2": "#7ad08a", "maxHeightCm": 3, "spreadCm": 15, "growthCmPerWeek": 0.3, "light": "medium", "leafLength": 1.2, "leafWidth": 0.15, "leafShape": "feathery", "palatable": false, "description": "Clusters of eight-armed, feathery polyps on creeping stolons, often with a glowing green centre." },
  { "id": "discosoma-red", "commonName": "Red mushroom", "scientificName": "Discosoma sp.", "water": "marine", "form": "mushroom-coral", "placement": "epiphyte", "color": "#a33a4a", "color2": "#d46a78", "maxHeightCm": 3, "spreadCm": 12, "growthCmPerWeek": 0.05, "light": "low", "leafLength": 4, "leafWidth": 4, "leafShape": "round", "palatable": false, "description": "Smooth, flat discs of red corallimorph that cluster on rock in dim light, slowly splitting into new mushrooms." },
  { "id": "discosoma-blue", "commonName": "Blue mushroom", "scientificName": "Discosoma sp. 'Blue'", "water": "marine", "form": "mushroom-coral", "placement": "epiphyte", "color": "#3a5aa4", "color2": "#7a96dc", "maxHeightCm": 3, "spreadCm": 12, "growthCmPerWeek": 0.05, "light": "low", "leafLength": 4, "leafWidth": 4, "leafShape": "round", "palatable": false, "description": "Velvet-blue mushroom discs with a slightly darker, spotted centre — glowing under actinic light." },
  { "id": "rhodactis-indosinensis", "commonName": "Hairy mushroom", "scientificName": "Rhodactis indosinensis", "water": "marine", "form": "mushroom-coral", "placement": "epiphyte", "color": "#5a7a4c", "color2": "#a6c87a", "maxHeightCm": 3, "spreadCm": 15, "growthCmPerWeek": 0.05, "light": "low", "leafLength": 5, "leafWidth": 5, "leafShape": "round", "palatable": false, "description": "A corallimorph whose discs are covered in short, branched tentacles, giving a shaggy, velvety texture." },
  { "id": "ricordea-florida", "commonName": "Ricordea florida", "scientificName": "Ricordea florida", "water": "marine", "form": "mushroom-coral", "placement": "epiphyte", "color": "#2a8c6c", "color2": "#f08a3a", "maxHeightCm": 2, "spreadCm": 10, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 3.5, "leafWidth": 3.5, "leafShape": "round", "palatable": false, "description": "A Caribbean mushroom covered in tiny bubble-like tentacles that fluoresce green and orange under blue light." },
  { "id": "ricordea-yuma", "commonName": "Ricordea yuma", "scientificName": "Ricordea yuma", "water": "marine", "form": "mushroom-coral", "placement": "epiphyte", "color": "#c86a2a", "color2": "#4ad08a", "maxHeightCm": 2, "spreadCm": 10, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 3.5, "leafWidth": 3.5, "leafShape": "round", "palatable": false, "description": "The Indo-Pacific cousin of the florida, with bumpy discs in startling multicoloured combinations." },
  { "id": "zoanthus-sociatus", "commonName": "Green button polyps", "scientificName": "Zoanthus sociatus", "water": "marine", "form": "zoanthid", "placement": "epiphyte", "color": "#4a8c3c", "color2": "#e2d050", "maxHeightCm": 2, "spreadCm": 12, "growthCmPerWeek": 0.15, "light": "medium", "leafLength": 1, "leafWidth": 0.8, "leafShape": "round", "palatable": false, "description": "A carpet of small colonial polyps with green oral discs and short tentacles — hardy, fast spreading and bright under blue light." },
  { "id": "zoanthus-rasta", "commonName": "Rasta zoanthids", "scientificName": "Zoanthus sp. 'Rasta'", "water": "marine", "form": "zoanthid", "placement": "epiphyte", "color": "#e07a2a", "color2": "#3ac080", "maxHeightCm": 2, "spreadCm": 10, "growthCmPerWeek": 0.12, "light": "medium", "leafLength": 1, "leafWidth": 0.8, "leafShape": "round", "palatable": false, "description": "Orange-rimmed polyps with green and yellow centres — one of countless named colour morphs collected by reefkeepers." },
  { "id": "palythoa-grandis", "commonName": "Palythoa", "scientificName": "Palythoa grandis", "water": "marine", "form": "zoanthid", "placement": "epiphyte", "color": "#a48c5c", "color2": "#dcc262", "maxHeightCm": 3, "spreadCm": 15, "growthCmPerWeek": 0.12, "light": "medium", "leafLength": 2, "leafWidth": 1.6, "leafShape": "round", "palatable": false, "description": "Large-polyped colonial zoanthids in tan and gold. Handle with care: many Palythoa contain the potent toxin palytoxin." },
  { "id": "euphyllia-ancora", "commonName": "Hammer coral", "scientificName": "Euphyllia ancora", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#7a9a5c", "color2": "#c8f07a", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.05, "light": "medium", "leafLength": 6, "leafWidth": 0.6, "leafShape": "lobed", "palatable": false, "description": "A large-polyp stony coral whose long, flowing tentacles end in anchor- or hammer-shaped tips that glow under blue light." },
  { "id": "euphyllia-divisa", "commonName": "Frogspawn coral", "scientificName": "Euphyllia divisa", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#6a8a6a", "color2": "#e2c8e6", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.05, "light": "medium", "leafLength": 5, "leafWidth": 0.6, "leafShape": "round", "palatable": false, "description": "Tentacles branching into clusters of rounded tips like masses of frog eggs, swaying together in the current." },
  { "id": "euphyllia-glabrescens", "commonName": "Torch coral", "scientificName": "Euphyllia glabrescens", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#8a7a4a", "color2": "#e0f262", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.05, "light": "medium", "leafLength": 8, "leafWidth": 0.5, "leafShape": "needle", "palatable": false, "description": "Long, flowing tentacles with bright round tips, like torches swaying in the flow. Clownfish sometimes adopt it as a host." },
  { "id": "duncanopsammia-axifuga", "commonName": "Duncan coral", "scientificName": "Duncanopsammia axifuga", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#3c8a5c", "color2": "#9c5ca4", "maxHeightCm": 8, "spreadCm": 12, "growthCmPerWeek": 0.1, "light": "medium", "leafLength": 1.5, "leafWidth": 0.4, "leafShape": "round", "palatable": false, "description": "Tubular corallites, each crowned by a flat green disc fringed with short purple tentacles. Readily takes food." },
  { "id": "micromussa-lordhowensis", "commonName": "Acan lord", "scientificName": "Micromussa lordhowensis", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#a43a3c", "color2": "#4cd474", "maxHeightCm": 6, "spreadCm": 15, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 1.8, "leafWidth": 1.8, "leafShape": "round", "palatable": false, "description": "A mound of fleshy, swollen polyps in a riot of colours — each polyp rimmed and centred in contrasting shades." },
  { "id": "dipsastraea-speciosa", "commonName": "Favia brain coral", "scientificName": "Dipsastraea speciosa", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#6a7a3c", "color2": "#56f08a", "maxHeightCm": 8, "spreadCm": 15, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 1, "leafWidth": 1, "leafShape": "round", "palatable": false, "description": "A massive dome of round, separate corallites, typically olive with glowing green centres; sweeper tentacles emerge at night." },
  { "id": "favites-abdita", "commonName": "Favites brain coral", "scientificName": "Favites abdita", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#8a5a3c", "color2": "#4ce0a4", "maxHeightCm": 8, "spreadCm": 15, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 1, "leafWidth": 1, "leafShape": "round", "palatable": false, "description": "A honeycomb brain coral whose polygonal corallites share walls; brown to red with fluorescent green eyes." },
  { "id": "platygyra-sinensis", "commonName": "Maze brain coral", "scientificName": "Platygyra sinensis", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#7a6a3e", "color2": "#74d69a", "maxHeightCm": 10, "spreadCm": 20, "growthCmPerWeek": 0.02, "light": "medium", "leafLength": 0.5, "leafWidth": 0.5, "leafShape": "lobed", "palatable": false, "description": "A massive dome furrowed by long, meandering valleys like the folds of a brain: brown walls over fluorescent green valley floors. It grows only about a centimetre a year." },
  { "id": "goniopora-lobata", "commonName": "Flowerpot coral", "scientificName": "Goniopora lobata", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#b2a262", "color2": "#e4dc86", "maxHeightCm": 15, "spreadCm": 15, "growthCmPerWeek": 0.05, "light": "medium", "leafLength": 3, "leafWidth": 0.6, "leafShape": "feathery", "palatable": false, "description": "Hundreds of long, daisy-like polyps extend from a rounded skeleton, so the whole colony looks like a swaying bouquet." },
  { "id": "trachyphyllia-geoffroyi", "commonName": "Open brain coral", "scientificName": "Trachyphyllia geoffroyi", "water": "marine", "form": "lps-coral", "placement": "foreground", "color": "#a8323e", "color2": "#3cd48e", "maxHeightCm": 6, "spreadCm": 15, "growthCmPerWeek": 0.02, "light": "medium", "leafLength": 12, "leafWidth": 8, "leafShape": "lobed", "palatable": false, "description": "A free-living brain coral that rests on sand: fleshy, folded valleys inflate by day in fluorescent reds and greens." },
  { "id": "danafungia-scruposa", "commonName": "Plate coral", "scientificName": "Danafungia scruposa", "water": "marine", "form": "lps-coral", "placement": "foreground", "color": "#8a6c4c", "color2": "#e2a6a6", "maxHeightCm": 4, "spreadCm": 15, "growthCmPerWeek": 0.02, "light": "medium", "leafLength": 14, "leafWidth": 14, "leafShape": "round", "palatable": false, "description": "A solitary, free-living disc coral with radiating septa like the gills of a mushroom. It can slowly right itself if flipped." },
  { "id": "caulastrea-furcata", "commonName": "Candy cane coral", "scientificName": "Caulastrea furcata", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#6c5a3a", "color2": "#4cd482", "maxHeightCm": 10, "spreadCm": 15, "growthCmPerWeek": 0.05, "light": "medium", "leafLength": 1.5, "leafWidth": 1.5, "leafShape": "round", "palatable": false, "description": "Branching tubes each capped by a round polyp striped like a candy cane, with fluorescent green or teal centres." },
  { "id": "plerogyra-sinuosa", "commonName": "Bubble coral", "scientificName": "Plerogyra sinuosa", "water": "marine", "form": "lps-coral", "placement": "epiphyte", "color": "#dcdac2", "color2": "#b6caa2", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.03, "light": "low", "leafLength": 2.5, "leafWidth": 2.5, "leafShape": "round", "palatable": false, "description": "By day it inflates grape-like, water-filled vesicles that shield it from light; at night they deflate and feeding tentacles emerge." },
  { "id": "catalaphyllia-jardinei", "commonName": "Elegance coral", "scientificName": "Catalaphyllia jardinei", "water": "marine", "form": "lps-coral", "placement": "foreground", "color": "#7a9a7a", "color2": "#e47ab4", "maxHeightCm": 15, "spreadCm": 25, "growthCmPerWeek": 0.03, "light": "medium", "leafLength": 7, "leafWidth": 0.6, "leafShape": "needle", "palatable": false, "description": "Long, translucent green tentacles with vivid pink tips flowing from a fleshy oral disc; lives on soft bottoms." },
  { "id": "acropora-millepora", "commonName": "Purple acropora", "scientificName": "Acropora millepora", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#8a6aa4", "color2": "#e2b4ec", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.15, "light": "high", "leafLength": 3, "leafWidth": 0.8, "leafShape": "needle", "palatable": false, "description": "A corymbose acropora of short, upright branchlets with pastel tips — demanding stable chemistry, strong light and flow." },
  { "id": "acropora-tenuis", "commonName": "Green slimer", "scientificName": "Acropora tenuis", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#6a9a52", "color2": "#7ab6ec", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.15, "light": "high", "leafLength": 4, "leafWidth": 0.8, "leafShape": "needle", "palatable": false, "description": "A tabling-branching acropora in minty green with blue polyp tips; one of the easier acros to keep." },
  { "id": "acropora-formosa", "commonName": "Staghorn coral", "scientificName": "Acropora muricata", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#b6a678", "color2": "#6aa2e4", "maxHeightCm": 25, "spreadCm": 25, "growthCmPerWeek": 0.25, "light": "high", "leafLength": 8, "leafWidth": 1, "leafShape": "needle", "palatable": false, "description": "Long, antler-like branches that build entire reef thickets in the wild; cream-coloured with electric blue growing tips." },
  { "id": "acropora-hyacinthus", "commonName": "Table acropora", "scientificName": "Acropora hyacinthus", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#8a7a52", "color2": "#c87ad4", "maxHeightCm": 8, "spreadCm": 30, "growthCmPerWeek": 0.2, "light": "high", "leafLength": 2, "leafWidth": 0.6, "leafShape": "round", "palatable": false, "description": "Forms flat, layered tables of fine, interlocking branchlets with violet rims, shading the reef beneath." },
  { "id": "montipora-capricornis", "commonName": "Montipora cap", "scientificName": "Montipora capricornis", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#c2702c", "color2": "#ecaa56", "maxHeightCm": 10, "spreadCm": 25, "growthCmPerWeek": 0.12, "light": "medium", "leafLength": 10, "leafWidth": 8, "leafShape": "round", "palatable": false, "description": "Thin, swirling plates that spiral outward in tiers like a whorl of orange paper — one of the easiest SPS." },
  { "id": "montipora-digitata", "commonName": "Montipora digitata", "scientificName": "Montipora digitata", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#b2603c", "color2": "#e09468", "maxHeightCm": 15, "spreadCm": 20, "growthCmPerWeek": 0.12, "light": "medium", "leafLength": 4, "leafWidth": 1, "leafShape": "needle", "palatable": false, "description": "Finger-like branches with fuzzy polyps in orange, green or purple; hardy and fast growing." },
  { "id": "seriatopora-hystrix", "commonName": "Birdsnest coral", "scientificName": "Seriatopora hystrix", "water": "marine", "form": "sps-coral", "placement": "epiphyte", "color": "#d27c9c", "color2": "#f2c4d6", "maxHeightCm": 15, "spreadCm": 15, "growthCmPerWeek": 0.15, "light": "medium", "leafLength": 3, "leafWidth": 0.3, "leafShape": "needle", "palatable": false, "description": "A tangle of thin, sharp-tipped pink branches that interlace like a bird’s nest." },
